{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/:endpoint(health|predict|explain|matched-pair|fairness|calibration|proxy-audit|comparison|tradeoff|examples)",
